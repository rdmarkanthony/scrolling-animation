---
layout: base.njk
title: Scrolling Animation
---

{% from "components/code-block.njk" import codeBlock %}

{# covers the sticky video until the intro #}
<div class="relative z-2 min-h-screen bg-white">
    <section class="px-4 pt-24 pb-16 md:pt-32">
        <div class="mx-auto max-w-5xl">
            <p class="mb-4 font-mono text-sm text-gray-500">11ty · Nunjucks · Tailwind · gsap</p>
            <h1 class="mb-6 text-5xl font-bold tracking-tight md:text-7xl">Scrolling Animation</h1>
            <p class="mb-10 max-w-2xl text-lg text-gray-600 md:text-xl">Scroll-driven animations for 11ty pages. Each demo is a section of markup with a short script under it, so you can copy one into your own page.</p>
            <div class="flex flex-wrap gap-3">
                <a class="js-auto-scroll rounded-full bg-gray-950 px-5 py-3 text-sm font-medium text-white transition-colors hover:bg-gray-700" href="#intro">See the intro demo</a>
                <a class="rounded-full border border-gray-300 px-5 py-3 text-sm font-medium text-gray-950 transition-colors hover:border-gray-950" href="https://github.com/rdmarkanthony/scrolling-animation" target="_blank" rel="noopener">View on GitHub</a>
            </div>
        </div>
    </section>

    <section class="px-4 py-16">
        <div class="mx-auto max-w-5xl">
            <h2 class="mb-8 text-3xl font-bold tracking-tight">Demos</h2>
            <div class="grid gap-6 md:grid-cols-3">
                <a class="js-auto-scroll group flex flex-col rounded-2xl border border-gray-200 p-6 transition-colors hover:border-gray-950" href="#intro">
                    <h3 class="mb-2 text-xl font-semibold">Title intro</h3>
                    <p class="mb-6 flex-1 text-gray-600">A sticky video whose dark cover fades as the section scrolls in, then titles step in one at a time.</p>
                    <p class="mb-4 font-mono text-xs text-gray-500">_parallaxScroller</p>
                    <span class="text-sm font-medium">On this page ↓</span>
                </a>
                <a class="group flex flex-col rounded-2xl border border-gray-200 p-6 transition-colors hover:border-gray-950" href="/canvas/">
                    <h3 class="mb-2 text-xl font-semibold">Canvas image sequence</h3>
                    <p class="mb-6 flex-1 text-gray-600">50 frames drawn on a canvas, the frame follows the scroll position like a video scrubber.</p>
                    <p class="mb-4 font-mono text-xs text-gray-500">_canvasBanner</p>
                    <span class="text-sm font-medium">Open demo <span class="inline-block transition-transform group-hover:translate-x-1">→</span></span>
                </a>
                <a class="group flex flex-col rounded-2xl border border-gray-200 p-6 transition-colors hover:border-gray-950" href="/background/">
                    <h3 class="mb-2 text-xl font-semibold">Parallax background</h3>
                    <p class="mb-6 flex-1 text-gray-600">Backgrounds move slower than the page, with or without easing, plus a floating image.</p>
                    <p class="mb-4 font-mono text-xs text-gray-500">_parallaxBackground · _parallaxFloating</p>
                    <span class="text-sm font-medium">Open demo <span class="inline-block transition-transform group-hover:translate-x-1">→</span></span>
                </a>
            </div>
        </div>
    </section>

    <section class="px-4 py-16">
        <div class="mx-auto max-w-5xl">
            <h2 class="mb-8 text-3xl font-bold tracking-tight">How it works</h2>
            <ol class="grid gap-10">
                <li class="grid gap-4 md:grid-cols-[1fr_2fr] md:gap-10">
                    <div>
                        <p class="mb-2 font-mono text-sm text-gray-500">01</p>
                        <h3 class="mb-2 text-xl font-semibold">script.js loads the utils</h3>
                        <p class="text-gray-600">It runs the shared setup for every page and puts every util on <code class="font-mono text-sm">window</code> for page scripts.</p>
                    </div>
                    {% set code %}{% raw %}
// src/assets/js/script.js
Object.assign(window, {
    gsap,
    _event,
    _parallax,
    _parallaxScroller,
    _parallaxBackground,
    _parallaxFloating,
    _canvasBanner,
    _autoScroll,
    _hlsVideo,
});
                    {% endraw %}{% endset %}
                    {{ codeBlock(code, 'js') }}
                </li>
                <li class="grid gap-4 md:grid-cols-[1fr_2fr] md:gap-10">
                    <div>
                        <p class="mb-2 font-mono text-sm text-gray-500">02</p>
                        <h3 class="mb-2 text-xl font-semibold">Mark up the section</h3>
                        <p class="text-gray-600">Style with Tailwind classes. Add <code class="font-mono text-sm">js-</code> classes for elements the script looks up, and <code class="font-mono text-sm">data-</code> attributes for options.</p>
                    </div>
                    {% set code %}{% raw %}
<div class="js-fade-section relative min-h-screen bg-black text-white">
    <h2 class="sticky top-0 py-40 text-center text-5xl">Fades in on scroll</h2>
</div>
                    {% endraw %}{% endset %}
                    {{ codeBlock(code, 'html') }}
                </li>
                <li class="grid gap-4 md:grid-cols-[1fr_2fr] md:gap-10">
                    <div>
                        <p class="mb-2 font-mono text-sm text-gray-500">03</p>
                        <h3 class="mb-2 text-xl font-semibold">Add the page script</h3>
                        <p class="text-gray-600">Put it in <code class="font-mono text-sm">{% raw %}{% footerscript %}{% endraw %}</code> so it renders below <code class="font-mono text-sm">script.js</code>. Use <code class="font-mono text-sm">type="module"</code> so it runs after it.</p>
                    </div>
                    {% set code %}{% raw %}
{% footerscript %}
<script type="module">
    new _parallaxScroller({
        target: document.querySelector('.js-fade-section'),
        events: {
            // offset.current is 0 when the section enters the screen and 1 when it leaves
            update(scroller) {
                gsap.set(scroller.target, { opacity: _parallax.clamp(scroller.portion('0%', '50%')) });
            },
        },
    });
</script>
{% endfooterscript %}
                    {% endraw %}{% endset %}
                    {{ codeBlock(code, 'njk') }}
                </li>
            </ol>
        </div>
    </section>

    <section class="px-4 pt-16 pb-32">
        <div class="mx-auto max-w-5xl">
            <p class="mb-2 font-mono text-sm text-gray-500">Demo</p>
            <h2 class="mb-4 text-3xl font-bold tracking-tight">Title intro</h2>
            <p class="mb-10 max-w-2xl text-gray-600">The next section is the live demo. Its markup and page script are in <code class="font-mono text-sm">src/index.njk</code>.</p>
            <p class="animate-bounce text-sm font-medium">Scroll down ↓</p>
        </div>
    </section>
</div>

{# demo: title intro #}
<div class="js-title-intro relative z-1 min-h-[150vh] bg-black text-white">
    <div class="sticky top-0 -mt-[100vh] h-screen w-full overflow-hidden">
        <div class="absolute inset-0 after:absolute after:inset-0 after:z-2 after:bg-black/20">
            <video class="js-hls-video absolute inset-0 size-full object-cover" data-src="/assets/video/video1/video1.m3u8" muted playsinline loop autoplay disablepictureinpicture disableremoteplayback aria-hidden="true"></video>
        </div>
        <div class="js-title-intro-cover absolute inset-0 z-1 bg-black"></div>
    </div>
    <div id="intro" class="js-title-intro-content relative z-2 pt-[50vh] pb-[35vh]">
        <div class="px-4">
            <div class="mx-auto max-w-5xl text-center">
                <ul class="js-title-intro-list">
                    <li class="translate-y-17.5 pb-20 opacity-0 transition duration-500 last:pb-0 data-[state=active]:translate-y-0 data-[state=active]:opacity-100 data-[state=past]:-translate-y-17.5"><h2 class="mb-2 text-5xl leading-[1.2] font-bold md:text-[80px]">Scroll to drive the animation</h2></li>
                    <li class="translate-y-17.5 pb-20 opacity-0 transition duration-500 last:pb-0 data-[state=active]:translate-y-0 data-[state=active]:opacity-100 data-[state=past]:-translate-y-17.5"><h2 class="mb-2 text-5xl leading-[1.2] font-bold md:text-[80px]">The cover fades as the section enters</h2></li>
                    <li class="translate-y-17.5 pb-20 opacity-0 transition duration-500 last:pb-0 data-[state=active]:translate-y-0 data-[state=active]:opacity-100 data-[state=past]:-translate-y-17.5"><h2 class="mb-2 text-5xl leading-[1.2] font-bold md:text-[80px]">Each title steps in at mid screen</h2></li>
                    <li class="translate-y-17.5 pb-20 opacity-0 transition duration-500 last:pb-0 data-[state=active]:translate-y-0 data-[state=active]:opacity-100 data-[state=past]:-translate-y-17.5"><h2 class="mb-2 text-5xl leading-[1.2] font-bold md:text-[80px]">States are data attributes</h2></li>
                    <li class="translate-y-17.5 pb-20 opacity-0 transition duration-500 last:pb-0 data-[state=active]:translate-y-0 data-[state=active]:opacity-100 data-[state=past]:-translate-y-17.5"><h2 class="mb-2 text-5xl leading-[1.2] font-bold md:text-[80px]">Copy the section and its script</h2></li>
                </ul>
            </div>
        </div>
    </div>
</div>

<div class="px-4 py-24">
    <div class="mx-auto max-w-5xl">
        <h2 class="mb-4 text-3xl font-bold tracking-tight">Utilities</h2>
        <p class="mb-12 max-w-2xl text-gray-600">The scroll and parallax utils, all in <code class="font-mono text-sm">src/assets/js/utils/</code> and used in page scripts.</p>

        <div class="grid gap-6">
            <div class="rounded-2xl border border-gray-200 p-6">
                <h3 class="mb-1 font-mono font-semibold">_parallaxScroller</h3>
                <p class="mb-4 text-gray-600">Measures the target when the page resizes, then on scroll only does the math, at most once per frame. <code class="font-mono text-sm">offset.current</code> is 0 when the target enters the screen and 1 when it leaves, unclamped. Change <code class="font-mono text-sm">offset.top</code> and <code class="font-mono text-sm">offset.bottom</code> in <code class="font-mono text-sm">resize</code> for another range. <code class="font-mono text-sm">portion(min, max)</code> gives the progress within part of the range, as percents of <code class="font-mono text-sm">offset.current</code> or as scroll positions.</p>
                {% set code %}{% raw %}
const scroller = new _parallaxScroller({
    target: document.querySelector('.js-my-section'),
    events: {
        // once, before measuring
        init(scroller) {},
        // after measuring, e.g. from the section's top until its end reaches the bottom of the screen
        resize(scroller) {
            const _offset = _parallax.getOffset(scroller.target);
            scroller.offset.top = _offset.top;
            scroller.offset.bottom = _offset.bottom - _event.height();
        },
        // on scroll
        update(scroller) {
            const _progress = _parallax.clamp(scroller.portion('20%', '60%'));
            gsap.set(scroller.target, { scale: 0.8 + _progress * 0.2 });
        },
    },
});

scroller.on('update', (scroller) => {}); // more listeners, remove with off()
scroller.destroy();
                {% endraw %}{% endset %}
                {{ codeBlock(code, 'js') }}
            </div>
            <div class="rounded-2xl border border-gray-200 p-6">
                <h3 class="mb-1 font-mono font-semibold">_canvasBanner</h3>
                <p class="mb-4 text-gray-600">Preloads an image sequence and draws the frame for <code class="font-mono text-sm">update(progress)</code>, 0 to 1. Sizes itself to its parent, sharp on high density screens, with an optional crossfade between frames.</p>
                {% set code %}{% raw %}
const canvas = new _canvasBanner({
    target: document.querySelector('.js-my-canvas'),
    assets: { count: 50, path: '/assets/img/frames/frame_', size: [1004, 1214], resizeMode: 'contain' },
    transition: { duration: 150 },
});

new _parallaxScroller({
    target: document.querySelector('.js-my-section'),
    events: {
        update: (scroller) => canvas.update(scroller.offset.current),
    },
});
                {% endraw %}{% endset %}
                {{ codeBlock(code, 'js') }}
            </div>
            <div class="rounded-2xl border border-gray-200 p-6">
                <h3 class="mb-1 font-mono font-semibold">_parallaxBackground · _parallaxFloating</h3>
                <p class="mb-4 text-gray-600">The background is made <code class="font-mono text-sm">range</code> pixels taller than its <code class="font-mono text-sm">overflow-hidden</code> parent and moves from <code class="font-mono text-sm">-range</code> to 0 as the parent crosses the screen. <code class="font-mono text-sm">easing</code> smooths it. The floating element drifts down by its range, eased. Both are built on <code class="font-mono text-sm">_parallaxScroller</code> and stay still when reduced motion is on.</p>
                {% set code %}{% raw %}
<div class="relative overflow-hidden">
    <div class="absolute inset-0 bg-cover" data-parallax-background="100,easing" style="background-image: url('/assets/img/banner1.jpg')"></div>
</div>
<img data-parallax-floating="50" src="/assets/img/banner1.jpg" alt="" />

document.querySelectorAll('[data-parallax-background]').forEach((target) => new _parallaxBackground({ target }));
document.querySelectorAll('[data-parallax-floating]').forEach((target) => new _parallaxFloating({ target }));
                {% endraw %}{% endset %}
                {{ codeBlock(code) }}
            </div>
            <div class="rounded-2xl border border-gray-200 p-6">
                <h3 class="mb-1 font-mono font-semibold">_parallax · _event</h3>
                <p class="mb-4 text-gray-600">Helpers the other utils are built on. <code class="font-mono text-sm">_event</code> keeps one scroll and one resize listener for the whole page, however many callbacks are added.</p>
                {% set code %}{% raw %}
_parallax.scrollTop();        // current scroll position
_parallax.getOffset(el);      // { top, left, bottom, right } in the document, transforms ignored
_parallax.getRange(min, max); // 0 at min, 1 at max, unclamped
_parallax.clamp(value);       // limit to 0 - 1

_event.resize((state) => {});  // state: init, ready, resize, after
_event.scroll((e) => {});      // runs once now, then at most once per frame while scrolling
_event.observeResize((entry) => {}, el); // el changes size, e.g. images load above it

const off = _event.scroll(callback); // every subscribe returns a function that removes it
off();

_event.width();                // viewport size without the scrollbar
_event.height();
_event.dispatch(el, 'visible', { index: 1 }); // listeners read e.detail
                {% endraw %}{% endset %}
                {{ codeBlock(code, 'js') }}
            </div>
        </div>
    </div>
</div>

{% footerscript %}
<!-- this script is just for this page -->
<script type="module">
    // Requirements
        // JS
            // gsap
            // src/assets/js/utils/_event.js
            // src/assets/js/utils/_parallax.js

    // animate the intro section with video banner
    new _parallaxScroller({
        target: document.querySelector('.js-title-intro-content'),
        events: {
            init(scroller) {
                scroller.el.cover = scroller.target.closest('.js-title-intro').querySelector('.js-title-intro-cover');
                scroller.el.listWrap = scroller.target.querySelector('.js-title-intro-list');
                scroller.el.list = [...scroller.el.listWrap.children];
            },
            resize(scroller) {
                const _height = _event.height();
                const _top = _parallax.getOffset(scroller.target).top;

                // while the content enters the screen
                scroller.offset.top = _top - _height;
                scroller.offset.bottom = _top;

                // for the titles fade in
                scroller.fade = [_top - _height * 0.4, _parallax.getOffset(scroller.el.listWrap).top - _height * 0.55];

                // when each title reaches the middle of the display
                scroller.steps = scroller.el.list.map((item) => _parallax.getOffset(item).top - _height * 0.5 - item.offsetHeight * 0.25);
            },
            update(scroller) {
                // animate the video dim cover
                gsap.set(scroller.el.cover, { opacity: 1 - _parallax.clamp(scroller.offset.current) });

                // animate the titles parent container
                gsap.set(scroller.target, { opacity: _parallax.clamp(scroller.portion(...scroller.fade)) });

                // which title is in the middle of the display
                const _scrollTop = _parallax.scrollTop();
                const _current = scroller.steps.reduce((current, step, index) => (_scrollTop >= step ? index : current), 0);

                // show the current title
                scroller.el.list.forEach((item, index) => {
                    item.dataset.state = index < _current ? 'past' : index === _current ? 'active' : '';
                });
            },
        },
    });
</script>
{% endfooterscript %}
