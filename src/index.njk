---
layout: base.njk
title: Scrolling Animation
---

<div class="section section-one relative z-[2] min-h-screen bg-white">
    <div class="com_section-content">
        <div class="px-[15px] py-[100px]">
            <div class="mx-auto max-w-5xl">
                <ul class="links-animate">
                    <li><a href="#intro">fixed video background</a></li>
                    <li><a href="/canvas/" target="_blank">canvas</a></li>
                    <li><a href="/background/" target="_blank">background</a></li>
                </ul>
            </div>
        </div>
    </div>
</div>
<div class="section section-title-intro min-h-[150vh]">
    <div class="com_sticky-content">
        <div class="com_video-content content-cover">
            <video muted playsinline loop autoplay preload="none" src="/assets/video/video1.mp4"></video>
        </div>
        <div class="com_cover-content"></div>
    </div>
    <div id="intro" class="com_section-content">
        <div class="px-[15px]">
            <div class="mx-auto max-w-5xl text-center">
                <ul class="se-ti-in-list">
                    <li><h1>Lorem ipsum dolor sit amet</h1></li>
                    <li><h1>consectetur adipiscing elit, sed do eiusmod tempor</h1></li>
                    <li><h1>Ut enim ad minim veniam</h1></li>
                    <li><h1>quis nostrud exercitation ullamco laboris nisi ut</h1></li>
                    <li><h1>Duis aute irure dolor in reprehenderit in voluptate velit esse</h1></li>
                </ul>
            </div>
        </div>
    </div>
</div>
<div class="section min-h-screen"></div>

{% footerscript %}
<!-- this script is just for this page -->
<script type="module">
    // Requirements
        // JS
            // gsap
            // src/assets/js/utils/_event.js
            // src/assets/js/utils/_scroll.js
            // src/assets/js/utils/_scroller.js
        // CSS
            // src/assets/css/components/scrolling.css (.section-title-intro)

    // animate the intro section with video banner
    new _scroller({
        target: document.querySelector('.section-title-intro'),
        init(scroller) {
            scroller.el.sc = scroller.target.querySelector('.com_section-content');
            scroller.el.cover = scroller.target.querySelector('.com_cover-content');
            scroller.el.listWrap = scroller.target.querySelector('.se-ti-in-list');
            scroller.el.list = scroller.target.querySelectorAll('.se-ti-in-list li');
            scroller.currentList = 0;

            _event.resize(() => {
                scroller.offset.top = _scroll.offset(scroller.el.sc) - _event.height();
                scroller.offset.bottom = _scroll.offset(scroller.el.sc);
            });
        },
        update(scroller) {
            const _height = _event.height();
            const _scTop = _scroll.offset(scroller.el.sc);

            // animate the video dim cover
            gsap.set(scroller.el.cover, { opacity: 1 - _scroll.clamp(scroller.offset.current) });

            // animate the titles parent container
            // portion of scroller offset.current using %
            // gsap.set(scroller.el.sc, { opacity: _scroll.clamp(scroller.portion('65%', '90%')) });

            // portion of scroller offset using diff containers offsets
            gsap.set(scroller.el.sc, { opacity: _scroll.clamp(scroller.portion(_scTop - _height * 0.4, _scroll.offset(scroller.el.listWrap) - _height * 0.55)) });

            let _currentList = 0;

            // determine which title is in the middle of the display, then will add/remove class
            scroller.el.list.forEach((item, index) => {
                const _offset = _scroll.top() - (_scroll.offset(item) - _scTop) - _height * 0.5 + item.offsetHeight * 0.25;

                if (_offset >= 0) _currentList = index;

                if (index !== scroller.currentList) scroller.el.sc.classList.remove(`text-${index}`);
            });

            scroller.currentList = _currentList;
            scroller.el.sc.classList.add(`text-${scroller.currentList}`);
        },
    });
</script>
{% endfooterscript %}
