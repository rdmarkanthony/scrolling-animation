<div class="js-links-animate px-4 py-24">
    <div class="mx-auto max-w-5xl">
        <h2 class="mb-4 text-3xl font-bold tracking-tight">Utilities</h2>
        <p class="mb-12 max-w-2xl text-gray-600">The scroll and parallax utils, all in <code class="font-mono text-sm">src/assets/js/utils/</code> and used in page scripts.</p>

        <div class="grid gap-6">
            <div class="rounded-2xl border border-gray-200 p-6">
                <h3 class="mb-1 font-mono font-semibold">_scroller</h3>
                <p class="mb-4 text-gray-600">Runs <code class="font-mono text-sm">update()</code> on every scroll and resize. Set <code class="font-mono text-sm">offset.top</code> and <code class="font-mono text-sm">offset.bottom</code> in <code class="font-mono text-sm">init()</code>, then read <code class="font-mono text-sm">offset.current</code>: 0 at the top, 1 at the bottom, unclamped. <code class="font-mono text-sm">portion(min, max)</code> gives the progress within part of the range, as percents of <code class="font-mono text-sm">offset.current</code> or as scroll positions.</p>
                {% set code %}{% raw %}
new _scroller({
    target: document.querySelector('.js-my-section'),
    init(scroller) {
        _event.resize(() => {
            scroller.offset.top = _scroll.offset(scroller.target) - _event.height();
            scroller.offset.bottom = _scroll.offset(scroller.target) + scroller.target.offsetHeight;
        });
    },
    update(scroller) {
        const _progress = _scroll.clamp(scroller.portion('20%', '60%'));
        gsap.set(scroller.target, { scale: 0.8 + _progress * 0.2 });
    },
});
                {% endraw %}{% endset %}
                {{ codeBlock(code, 'js') }}
            </div>
            <div class="rounded-2xl border border-gray-200 p-6">
                <h3 class="mb-1 font-mono font-semibold">_canvasBanner</h3>
                <p class="mb-4 text-gray-600">Preloads an image sequence named <code class="font-mono text-sm">path + 0000.jpg</code> and draws the frame for the scroll position you pass to <code class="font-mono text-sm">update(top, bottom)</code>.</p>
                {% set code %}{% raw %}
new _canvasBanner({
    target: document.querySelector('.js-my-canvas'),
    assets: { count: 50, path: '/assets/img/frames/frame_', size: [1004, 1214] },
    init(canvas) {
        const _section = canvas.target.closest('.js-my-section');
        _event.scroll(() => {
            const _top = _scroll.offset(_section);
            canvas.update(_top, _top + _section.offsetHeight * 0.4);
        });
    },
});
                {% endraw %}{% endset %}
                {{ codeBlock(code, 'js') }}
            </div>
            <div class="rounded-2xl border border-gray-200 p-6">
                <h3 class="mb-1 font-mono font-semibold">_parallaxBackground · _parallaxFloating</h3>
                <p class="mb-4 text-gray-600">The background moves within an <code class="font-mono text-sm">overflow-hidden</code> parent, <code class="font-mono text-sm">range</code> in pixels, <code class="font-mono text-sm">easing</code> to smooth it. The floating element drifts down by its range.</p>
                {% set code %}{% raw %}
<div class="relative overflow-hidden">
    <div class="absolute inset-0 bg-cover" data-parallax-background="100,easing" style="background-image: url('/assets/img/banner1.jpg')"></div>
</div>
<img data-parallax-floating="50" src="/assets/img/banner1.jpg" alt="" />

document.querySelectorAll('[data-parallax-background]').forEach((target) => new _parallaxBackground({ target }));
document.querySelectorAll('[data-parallax-floating]').forEach((target) => new _parallaxFloating({ target }));
                {% endraw %}{% endset %}
                {{ codeBlock(code) }}
            </div>
            <div class="rounded-2xl border border-gray-200 p-6">
                <h3 class="mb-1 font-mono font-semibold">_scroll · _event</h3>
                <p class="mb-4 text-gray-600">Helpers the other utils are built on.</p>
                {% set code %}{% raw %}
_scroll.top();              // current scroll position
_scroll.offset(el);         // element top relative to the document
_scroll.progress(min, max); // 0 at min, 1 at max, unclamped
_scroll.clamp(value);       // limit to 0 - 1

_event.resize((state) => {}); // state: init, ready, resize, after
_event.scroll((e) => {});     // runs once now, then on every scroll
_event.width();               // viewport size without the scrollbar
_event.height();
                {% endraw %}{% endset %}
                {{ codeBlock(code, 'js') }}
            </div>
        </div>
    </div>
</div>

{% footerscript %}
<!-- this script is just for this page -->
<script type="module">
    // Requirements
        // JS
            // gsap
            // src/assets/js/utils/_event.js
            // src/assets/js/utils/_scroll.js
            // src/assets/js/utils/_scroller.js

    // animate the intro section with video banner
    new _scroller({
        target: document.querySelector('.js-title-intro'),
        init(scroller) {
            scroller.el.sc = scroller.target.querySelector('.js-title-intro-content');
            scroller.el.cover = scroller.target.querySelector('.js-title-intro-cover');
            scroller.el.listWrap = scroller.target.querySelector('.js-title-intro-list');
            scroller.el.list = scroller.target.querySelectorAll('.js-title-intro-list li');
            scroller.currentList = 0;

            _event.resize(() => {
                scroller.offset.top = _scroll.offset(scroller.el.sc) - _event.height();
                scroller.offset.bottom = _scroll.offset(scroller.el.sc);
            });
        },
        update(scroller) {
            const _height = _event.height();
            const _scTop = _scroll.offset(scroller.el.sc);

            // animate the video dim cover
            gsap.set(scroller.el.cover, { opacity: 1 - _scroll.clamp(scroller.offset.current) });

            // animate the titles parent container
            // portion of scroller offset.current using %
            // gsap.set(scroller.el.sc, { opacity: _scroll.clamp(scroller.portion('65%', '90%')) });

            // portion of scroller offset using diff containers offsets
            gsap.set(scroller.el.sc, { opacity: _scroll.clamp(scroller.portion(_scTop - _height * 0.4, _scroll.offset(scroller.el.listWrap) - _height * 0.55)) });

            let _currentList = 0;

            // determine which title is in the middle of the display, its top above half the screen (plus a quarter of its height)
            scroller.el.list.forEach((item, index) => {
                const _offset = _height * 0.5 + item.offsetHeight * 0.25 - (_scroll.offset(item) - _scroll.top());

                if (_offset >= 0) _currentList = index;
            });

            scroller.currentList = _currentList;

            // show the current title, move the previous ones up (see data-[state] classes on each li)
            scroller.el.list.forEach((item, index) => {
                item.dataset.state = index < _currentList ? 'past' : index === _currentList ? 'active' : '';
            });
        },
    });
</script>
{% endfooterscript %}
