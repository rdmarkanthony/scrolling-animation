---
layout: base.njk
title: Scrolling Animation
---

<div class="relative z-2 min-h-screen bg-white outline outline-dashed outline-green-700">
    <div class="relative z-3">
        <div class="px-3.75 py-25">
            <div class="mx-auto max-w-5xl">
                <ul class="js-links-animate text-xl">
                    <li><a class="text-blue-500" href="#intro">fixed video background</a></li>
                    <li><a class="text-blue-500" href="/canvas/" target="_blank">canvas</a></li>
                    <li><a class="text-blue-500" href="/background/" target="_blank">background</a></li>
                </ul>
            </div>
        </div>
    </div>
</div>
<div class="js-title-intro relative z-1 min-h-[150vh] bg-black text-white outline outline-dashed outline-red-400">
    <div class="sticky top-0 -mt-[100vh] h-screen w-full overflow-hidden">
        <div class="absolute inset-0 after:absolute after:inset-0 after:z-2 after:bg-black/20">
            <video class="js-hls-video absolute inset-0 size-full object-cover" data-src="/assets/video/video1/video1.m3u8" muted playsinline loop autoplay disablepictureinpicture disableremoteplayback aria-hidden="true"></video>
        </div>
        <div class="js-title-intro-cover absolute inset-0 z-1 bg-black"></div>
    </div>
    <div id="intro" class="js-title-intro-content relative z-2 pt-[50vh] pb-[35vh]">
        <div class="px-3.75">
            <div class="mx-auto max-w-5xl text-center">
                <ul class="js-title-intro-list">
                    <li class="translate-y-17.5 pb-20 opacity-0 transition duration-500 last:pb-0 data-[state=active]:translate-y-0 data-[state=active]:opacity-100 data-[state=past]:-translate-y-17.5"><h1 class="mb-2 text-[80px] leading-[1.2] font-bold">Lorem ipsum dolor sit amet</h1></li>
                    <li class="translate-y-17.5 pb-20 opacity-0 transition duration-500 last:pb-0 data-[state=active]:translate-y-0 data-[state=active]:opacity-100 data-[state=past]:-translate-y-17.5"><h1 class="mb-2 text-[80px] leading-[1.2] font-bold">consectetur adipiscing elit, sed do eiusmod tempor</h1></li>
                    <li class="translate-y-17.5 pb-20 opacity-0 transition duration-500 last:pb-0 data-[state=active]:translate-y-0 data-[state=active]:opacity-100 data-[state=past]:-translate-y-17.5"><h1 class="mb-2 text-[80px] leading-[1.2] font-bold">Ut enim ad minim veniam</h1></li>
                    <li class="translate-y-17.5 pb-20 opacity-0 transition duration-500 last:pb-0 data-[state=active]:translate-y-0 data-[state=active]:opacity-100 data-[state=past]:-translate-y-17.5"><h1 class="mb-2 text-[80px] leading-[1.2] font-bold">quis nostrud exercitation ullamco laboris nisi ut</h1></li>
                    <li class="translate-y-17.5 pb-20 opacity-0 transition duration-500 last:pb-0 data-[state=active]:translate-y-0 data-[state=active]:opacity-100 data-[state=past]:-translate-y-17.5"><h1 class="mb-2 text-[80px] leading-[1.2] font-bold">Duis aute irure dolor in reprehenderit in voluptate velit esse</h1></li>
                </ul>
            </div>
        </div>
    </div>
</div>
<div class="relative min-h-screen outline outline-dashed outline-green-700"></div>

{% footerscript %}
<!-- this script is just for this page -->
<script type="module">
    // Requirements
        // JS
            // gsap
            // src/assets/js/utils/_event.js
            // src/assets/js/utils/_scroll.js
            // src/assets/js/utils/_scroller.js

    // animate the intro section with video banner
    new _scroller({
        target: document.querySelector('.js-title-intro'),
        init(scroller) {
            scroller.el.sc = scroller.target.querySelector('.js-title-intro-content');
            scroller.el.cover = scroller.target.querySelector('.js-title-intro-cover');
            scroller.el.listWrap = scroller.target.querySelector('.js-title-intro-list');
            scroller.el.list = scroller.target.querySelectorAll('.js-title-intro-list li');
            scroller.currentList = 0;

            _event.resize(() => {
                scroller.offset.top = _scroll.offset(scroller.el.sc) - _event.height();
                scroller.offset.bottom = _scroll.offset(scroller.el.sc);
            });
        },
        update(scroller) {
            const _height = _event.height();
            const _scTop = _scroll.offset(scroller.el.sc);

            // animate the video dim cover
            gsap.set(scroller.el.cover, { opacity: 1 - _scroll.clamp(scroller.offset.current) });

            // animate the titles parent container
            // portion of scroller offset.current using %
            // gsap.set(scroller.el.sc, { opacity: _scroll.clamp(scroller.portion('65%', '90%')) });

            // portion of scroller offset using diff containers offsets
            gsap.set(scroller.el.sc, { opacity: _scroll.clamp(scroller.portion(_scTop - _height * 0.4, _scroll.offset(scroller.el.listWrap) - _height * 0.55)) });

            let _currentList = 0;

            // determine which title is in the middle of the display
            scroller.el.list.forEach((item, index) => {
                const _offset = _scroll.top() - (_scroll.offset(item) - _scTop) - _height * 0.5 + item.offsetHeight * 0.25;

                if (_offset >= 0) _currentList = index;
            });

            scroller.currentList = _currentList;

            // show the current title, move the previous ones up (see data-[state] classes on each li)
            scroller.el.list.forEach((item, index) => {
                item.dataset.state = index < _currentList ? 'past' : index === _currentList ? 'active' : '';
            });
        },
    });
</script>
{% endfooterscript %}
