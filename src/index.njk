{% from "components/code-block.njk" import codeBlock %}

{# white section above the intro, it covers the sticky video until the intro scrolls in #}
<div class="js-links-animate relative z-2 min-h-screen bg-white">
    <section class="px-4 pt-24 pb-16 md:pt-32">
        <div class="mx-auto max-w-5xl">
            <p class="mb-4 font-mono text-sm text-gray-500">11ty · Nunjucks · Tailwind · gsap</p>
            <h1 class="mb-6 text-5xl font-bold tracking-tight md:text-7xl">Scrolling Animation</h1>
            <p class="mb-10 max-w-2xl text-lg text-gray-600 md:text-xl">Scroll-driven animations for 11ty pages. Each demo is a section of markup with a short script under it, so you can copy one into your own page.</p>
            <div class="flex flex-wrap gap-3">
                <a class="rounded-full bg-gray-950 px-5 py-3 text-sm font-medium text-white transition-colors hover:bg-gray-700" href="#intro">See the intro demo</a>
                <a class="rounded-full border border-gray-300 px-5 py-3 text-sm font-medium text-gray-950 transition-colors hover:border-gray-950" href="https://github.com/rdmarkanthony/scrolling-animation" target="_blank" rel="noopener">View on GitHub</a>
            </div>
        </div>
