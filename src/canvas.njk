---
layout: base.njk
title: Canvas | Scrolling Animation
---

{% from "components/back-link.njk" import backLink %}
{% from "components/code-block.njk" import codeBlock %}
{{ backLink() }}

<section class="px-4 pt-24 pb-16 md:pt-32">
    <div class="mx-auto max-w-5xl">
        <p class="mb-4 font-mono text-sm text-gray-500">Demo · _canvasBanner</p>
        <h1 class="mb-6 text-5xl font-bold tracking-tight md:text-7xl">Canvas image sequence</h1>
        <p class="max-w-2xl text-lg text-gray-600 md:text-xl">A set of frames drawn on a canvas, picked by the scroll position. Scrolling moves through the frames like scrubbing a video, forward and back.</p>
    </div>
</section>

<section class="px-4 py-16">
    <div class="mx-auto max-w-5xl">
        <h2 class="mb-2 text-3xl font-bold tracking-tight">The frames</h2>
        <p class="mb-8 max-w-2xl text-gray-600">50 JPGs named <code class="font-mono text-sm">large_0000.jpg</code> to <code class="font-mono text-sm">large_0049.jpg</code>. All of them load up front, so drawing a frame is instant.</p>
        <ul class="grid grid-cols-10 gap-1">
            {% for i in range(0, 50) %}
            <li><img class="w-full" src="/assets/img/headphone/large_{{ i | pad(4) }}.jpg" alt="" loading="lazy" /></li>
            {% endfor %}
        </ul>
        <p class="mt-16 animate-bounce text-sm font-medium">Scroll down ↓</p>
    </div>
</section>

{# demo #}
<section class="js-canvas-section relative min-h-[300vh]">
    <div class="sticky top-0 flex h-screen items-center justify-center p-6">
        <canvas class="js-canvas max-h-full max-w-full"></canvas>
        <p class="absolute right-6 bottom-6 rounded-full bg-white px-4 py-2 font-mono text-sm shadow-md">Frame <span class="js-canvas-frame">1</span> / 50</p>
    </div>
</section>

<section class="px-4 py-24">
    <div class="mx-auto max-w-5xl">
        <h2 class="mb-8 text-3xl font-bold tracking-tight">How it's built</h2>
        <div class="grid gap-10">
            <div class="grid gap-4 md:grid-cols-[1fr_2fr] md:gap-10">
                <div>
                    <h3 class="mb-2 text-xl font-semibold">Markup</h3>
                    <p class="text-gray-600">A tall section with a sticky, screen-high wrapper. The canvas stays pinned while the section scrolls past. <code class="font-mono text-sm">max-h-full max-w-full</code> fits the canvas on screen at its frame ratio.</p>
                </div>
                {% set code %}{% raw %}
<section class="js-canvas-section relative min-h-[300vh]">
    <div class="sticky top-0 flex h-screen items-center justify-center p-6">
        <canvas class="js-canvas max-h-full max-w-full"></canvas>
    </div>
</section>
                {% endraw %}{% endset %}
                {{ codeBlock(code, 'html') }}
            </div>
            <div class="grid gap-4 md:grid-cols-[1fr_2fr] md:gap-10">
                <div>
                    <h3 class="mb-2 text-xl font-semibold">Script</h3>
                    <p class="text-gray-600"><code class="font-mono text-sm">update(top, bottom)</code> draws the first frame at scroll position <code class="font-mono text-sm">top</code> and the last at <code class="font-mono text-sm">bottom</code>. Here that's while the section is pinned: from its top until its end reaches the bottom of the screen.</p>
                </div>
                {% set code %}{% raw %}
new _canvasBanner({
    target: document.querySelector('.js-canvas'),
    assets: {
        count: 50,
        path: '/assets/img/headphone/large_',
        size: [1004, 1214],
    },
    init(canvas) {
        const _section = canvas.target.closest('.js-canvas-section');

        _event.scroll(() => {
            const _top = _scroll.offset(_section);

            canvas.update(_top, _top + _section.offsetHeight - _event.height());
        });
    },
});
                {% endraw %}{% endset %}
                {{ codeBlock(code, 'js') }}
            </div>
            <div class="grid gap-4 md:grid-cols-[1fr_2fr] md:gap-10">
                <div>
                    <h3 class="mb-2 text-xl font-semibold">Options</h3>
                    <p class="text-gray-600">Frames are named <code class="font-mono text-sm">path</code> + a 4 digit number + <code class="font-mono text-sm">.type</code>, starting at <code class="font-mono text-sm">0000</code>.</p>
                </div>
                <dl class="grid gap-x-6 gap-y-1 rounded-2xl border border-gray-200 p-6 text-sm md:grid-cols-[auto_1fr] md:gap-y-3">
                    <dt class="font-mono font-semibold">assets.count</dt>
                    <dd class="mb-3 text-gray-600 last:mb-0 md:mb-0">Number of frames</dd>
                    <dt class="font-mono font-semibold">assets.path</dt>
                    <dd class="mb-3 text-gray-600 last:mb-0 md:mb-0">Frame path without the number, e.g. <code class="font-mono">/assets/img/frames/frame_</code></dd>
                    <dt class="font-mono font-semibold">assets.type</dt>
                    <dd class="mb-3 text-gray-600 last:mb-0 md:mb-0">File extension, default <code class="font-mono">jpg</code></dd>
                    <dt class="font-mono font-semibold">assets.size</dt>
                    <dd class="mb-3 text-gray-600 last:mb-0 md:mb-0">Frame size in pixels, <code class="font-mono">[width, height]</code>, used as the canvas size</dd>
                    <dt class="font-mono font-semibold">init(canvas)</dt>
                    <dd class="mb-3 text-gray-600 last:mb-0 md:mb-0">Runs once after setup, hook up <code class="font-mono">update()</code> here</dd>
                    <dt class="font-mono font-semibold">canvas.assets.current</dt>
                    <dd class="mb-3 text-gray-600 last:mb-0 md:mb-0">Index of the frame on screen</dd>
                </dl>
            </div>
        </div>
    </div>
</section>

{% footerscript %}
<!-- this script is just for this page -->
<script type="module">
    // Requirements
        // JS
            // src/assets/js/utils/_event.js
            // src/assets/js/utils/_scroll.js
            // src/assets/js/utils/_canvas-banner.js

    // image sequence drawn on canvas while scrolling
    new _canvasBanner({
        target: document.querySelector('.js-canvas'),
        assets: {
            count: 50,
            path: '/assets/img/headphone/large_',
            size: [1004, 1214],
        },
        init(canvas) {
            const _section = canvas.target.closest('.js-canvas-section');
            const _frame = _section.querySelector('.js-canvas-frame');

            // while the section is pinned
            _event.scroll(() => {
                const _top = _scroll.offset(_section);

                canvas.update(_top, _top + _section.offsetHeight - _event.height());
                _frame.textContent = canvas.assets.current + 1;
            });
        },
    });
</script>
{% endfooterscript %}
