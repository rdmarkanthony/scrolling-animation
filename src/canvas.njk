---
layout: base.njk
title: Canvas | Scrolling Animation
---

<div class="section com_image-list min-h-[50vh] py-[100px]">
    <div class="px-[15px]">
        <div class="mx-auto max-w-5xl pb-[50px]">
            <h2>Here's the list of image sequence</h2>
            <p>See below on how it animate thru scrolling</p>
        </div>
        <ul class="flex flex-wrap">
            {% for i in range(0, 50) %}
            <li class="w-[10%]"><img src="/assets/img/headphone/large_{{ i | pad(4) }}.jpg" alt="" /></li>
            {% endfor %}
        </ul>
    </div>
</div>
<div class="section min-h-[150vh]">
    <div class="com_sticky-content">
        <div class="relative mx-auto max-w-5xl">
            <div class="absolute inset-0">
                <canvas id="headphone" data-aspect-ratio="1004,1214"></canvas>
            </div>
        </div>
    </div>
</div>
<div class="section min-h-screen"></div>

{% footerscript %}
<!-- this script is just for this page -->
<script type="module">
    // Requirements
        // JS
            // src/assets/js/utils/_event.js
            // src/assets/js/utils/_scroll.js
            // src/assets/js/utils/_canvas-banner.js
        // CSS
            // src/assets/css/components/scrolling.css (.com_sticky-content)

    // image sequence drawn on canvas while scrolling
    new _canvasBanner({
        target: document.querySelector('#headphone'),
        assets: {
            count: 50,
            path: '/assets/img/headphone/large_',
            size: [1004, 1214],
        },
        init(canvas) {
            const _parent = canvas.target.closest('.section');

            _event.scroll(() => {
                const _top = _scroll.offset(_parent);

                canvas.update(_top, _top + _parent.offsetHeight * 0.4);
            });
        },
    });
</script>
{% endfooterscript %}
