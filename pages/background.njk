{% set pageTitle = 'Background | Scrolling Animation' %}

{% extends 'layout.njk' %}

{% block content %}
<div class="section com_height-100 bp-rel">
    <div class="com_banner bp-ab overflow-hidden">
        <div class="com_banner bp-ab" data-parallax-background style="background-image: url('{{ rootDir }}assets/img/banner1.jpg'); background-repeat: no-repeat;"></div>
    </div>
</div>
<div class="section section-three com_height-100">
    <div class="com_section-content">
        <div class="container-fluid">
            <div class="com_banner-content text-center">
                <div class="container" style="max-width: 500px;">
                    <div class="com_banner bg-black overflow-hidden" data-aspect-ratio="1006,1584">
                        <div class="com_banner bp-ab" data-parallax-background style="background-image: url('{{ rootDir }}assets/img/banner1.jpg'); background-repeat: no-repeat;"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block footerscript %}
<!-- this script is just for this page -->
<script>
    // for parallax background
    $('[data-parallax-background]').each(function() {
        new bp.parallax.background({target: this});
    });
</script>
{% endblock %}