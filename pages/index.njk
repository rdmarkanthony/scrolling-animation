{% set pageTitle = 'Scrolling Animation' %}

{% extends 'layout.njk' %}

{% block content %}
<div class="section section-one com_height-100">
    <div class="com_section-content">
        <div class="container-fluid">
            <div class="container">
                <ul class="links-animate">
                    <li><a href="#intro">fixed video background</a></li>
                    <li><a href="canvas.html" target="_blank">canvas</a></li>
                    <li><a href="background.html" target="_blank">background</a></li>
                </ul>
            </div>
        </div>
    </div>
</div>
<div class="section section-title-intro com_height-150">
    <div class="com_sticky-content">
        <div class="com_video-content content-cover">
            <video muted playsinline loop autoplay preload="none" src="{{ rootDir }}assets/video/video1.mp4"></video>
        </div>
        <div class="com_cover-content"></div>
    </div>
    <div id="intro" class="com_section-content">
        <div class="container-fluid">
            <div class="container text-center">
                <ul class="se-ti-in-list">
                    <li><h1>Lorem ipsum dolor sit amet</h1></li>
                    <li><h1>consectetur adipiscing elit, sed do eiusmod tempor</h1></li>
                    <li><h1>Ut enim ad minim veniam</h1></li>
                    <li><h1>quis nostrud exercitation ullamco laboris nisi ut</h1></li>
                    <li><h1>Duis aute irure dolor in reprehenderit in voluptate velit esse</h1></li>
                </ul>
            </div>
        </div>
    </div>
</div>
<div class="section com_height-100"></div>
{% endblock %}

{% block footerscript %}
<!-- this script is just for this page -->
<script>
    // animate the intro section with video banner
    const _titleIntro = new bp.parallax.scroller({
        target: document.querySelector('.section-title-intro'),
        init: function(scroller) {
            scroller.el.sc = scroller.target.querySelector('.com_section-content');
            scroller.el.cover = scroller.target.querySelector('.com_cover-content');

            scroller.el.list = scroller.target.querySelectorAll('.se-ti-in-list li');
            scroller.currentList = 0;

            bp.resizeFn(function() {
                scroller.offset.top = $(scroller.el.sc).offset().top - bp.height();
                scroller.offset.bottom = $(scroller.el.sc).offset().top;
            });

            // console.log('init', scroller);
        },
        update: function(scroller, e) {
            // animate the video dim cover
            TweenMax.set(scroller.el.cover, {opacity: 1 - bp.abs(scroller.offset.current)});

            // animate the titles parent container
            // portion of scroller offset.current using %
            // TweenMax.set(scroller.el.sc , {opacity: bp.abs(scroller.offset.portion('65%','90%')) });

            // portion of scroller offset using diff containers offsets
            TweenMax.set(scroller.el.sc , {opacity: bp.abs( scroller.offset.portion( $(scroller.el.sc).offset().top - (bp.height() * 0.4), $('.se-ti-in-list', scroller.target).offset().top - (bp.height() * 0.55) ) ) });

            let _currentList = 0;

            // determine which title is in the middle of the display, then will add/remove class
            $(scroller.el.list).each(function(index) {
                const _this = this;
                const _offset = bp.st() - ($(_this).offset().top - $(scroller.el.sc).offset().top) - (bp.height() * 0.5) + (_this.offsetHeight * 0.25);

                if(_offset >= 0) _currentList = index;

                if(index != scroller.currentList) $(scroller.el.sc).removeClass('text-' + index);
            });

            if(_currentList != scroller.currentList) { scroller.currentList = _currentList; }
            $(scroller.el.sc).addClass('text-' + scroller.currentList);

            // console.log('update', scroller.offset.current);
        }
    });
</script>
{% endblock %}