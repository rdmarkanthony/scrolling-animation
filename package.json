{
    "name": "scrolling-animation",
    "version": "3.0.0",
    "type": "module",
    "description": "scrolling animation template",
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "start": "npm-run-all -s clean -p 'dev:*'",
        "dev": "npm-run-all -s clean -p 'dev:*'",
        "dev:eleventy": "eleventy --serve",
        "dev:css": "tailwindcss -i ./src/assets/css/style.css -o ./public/assets/css/style.css --watch",
        "dev:js": "node esbuild.config.js --watch",
        "build": "npm-run-all -s clean 'build:*'",
        "build:eleventy": "eleventy",
        "build:css": "tailwindcss -i ./src/assets/css/style.css -o ./public/assets/css/style.css --minify",
        "build:js": "node esbuild.config.js",
        "clean": "node -e \"require('fs').rmSync('public', { recursive: true, force: true })\"",
        "format": "prettier --write ."
    },
    "author": "RippleWerkz",
    "license": "ISC",
    "dependencies": {
        "@11ty/eleventy": "^3.1.6",
        "gsap": "^3.15.0",
        "hls.js": "^1.7.3"
    },
    "devDependencies": {
        "@tailwindcss/cli": "^4.3.3",
        "dotenv": "^17.3.1",
        "esbuild": "^0.28.2",
        "npm-run-all2": "^8.0.4",
        "prettier": "^3.9.9",
        "prettier-plugin-jinja-template": "^2.2.0",
        "tailwindcss": "^4.3.3"
    }
}
